{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peitho.invalid/contracts/schemas/api-response-envelope.schema.json",
  "title": "Peitho API response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "timestamp",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "success",
        "error"
      ]
    },
    "data": {
      "type": "object",
      "description": "Present for successful responses; endpoint-specific result payload."
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,79}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "additionalProperties": true,
          "description": "Sanitized, non-sensitive validation details. Never include stack traces, secrets or data from another tenant."
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional safe metadata such as pagination or freshness state; never use it to bypass authorization."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "required": [
          "data"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "not": {
          "required": [
            "data"
          ]
        }
      }
    }
  ],
  "description": "Every API success/error uses the same envelope and echoes request_id. HTTP status codes remain authoritative; this schema does not replace correct HTTP semantics."
}
